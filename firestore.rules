rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // SESSÕES: Membros autenticados podem ler e criar
    match /sessoes/{sessaoId} {
      allow list: if request.auth != null;
      allow get: if request.auth != null;
      
      // Criar nova sala (exige que o criador seja o dono)
      allow create: if request.auth != null 
                    && request.resource.data.ownerUid == request.auth.uid;
                    
      // Atualizar (adicionar membros, salvar dados, etc)
      allow update: if request.auth != null 
                    && (resource.data.ownerUid == request.auth.uid 
                        || request.auth.uid in resource.data.members);
                        
      // Deletar (só o dono)
      allow delete: if request.auth != null 
                    && resource.data.ownerUid == request.auth.uid;

      // SUBCOLEÇÕES (dados, chats, etc)
      match /{subcollection=**}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // BLOQUEIA TUDO O RESTO
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
